{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/core/execution/directive_guard.py\"",
            "timeout": 5,
            "statusMessage": "DOE directive guard..."
          }
        ]
      }
    ]
  }
}
